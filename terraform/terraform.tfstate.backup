            "metadata": [
              {
                "app_version": "v1.18.1",
                "chart": "alloy",
                "first_deployed": 1786806143,
                "last_deployed": 1786806143,
                "name": "alloy",
                "namespace": "monitoring",
                "notes": "Welcome to Grafana Alloy!\n",
                "revision": 1,
                "values": "{\"alloy\":{\"configMap\":{\"content\":\"discovery.kubernetes \\\"pods\\\" {\\n  role = \\\"pod\\\"\\n}\\n\\ndiscovery.relabel \\\"pods\\\" {\\n  targets = discovery.kubernetes.pods.targets\\n\\n  rule {\\n    source_labels = [\\\"__meta_kubernetes_namespace\\\"]\\n    target_label  = \\\"namespace\\\"\\n  }\\n  rule {\\n    source_labels = [\\\"__meta_kubernetes_pod_name\\\"]\\n    target_label  = \\\"pod\\\"\\n  }\\n  rule {\\n    source_labels = [\\\"__meta_kubernetes_pod_container_name\\\"]\\n    target_label  = \\\"container\\\"\\n  }\\n}\\n\\nloki.source.kubernetes \\\"pods\\\" {\\n  targets    = discovery.relabel.pods.output\\n  forward_to = [loki.write.default.receiver]\\n}\\n\\nloki.write \\\"default\\\" {\\n  endpoint {\\n    url = \\\"http://loki.monitoring.svc.cluster.local:3100/loki/api/v1/push\\\"\\n  }\\n}\\n\"}},\"controller\":{\"type\":\"daemonset\"}}",
                "version": "1.11.1"
              }
            ],
            "name": "alloy",
            "namespace": "monitoring",
            "pass_credentials": false,
            "postrender": [],
            "recreate_pods": false,
            "render_subchart_notes": true,
            "replace": false,
            "repository": "https://grafana.github.io/helm-charts",
            "repository_ca_file": null,
            "repository_cert_file": null,
            "repository_key_file": null,
            "repository_password": null,
            "repository_username": null,
            "reset_values": false,
            "reuse_values": false,
            "set": [],
            "set_list": [],
            "set_sensitive": [],
            "skip_crds": false,
            "status": "deployed",
            "timeout": 300,
            "upgrade_install": null,
            "values": [
              "\"alloy\":\n  \"configMap\":\n    \"content\": |\n      discovery.kubernetes \"pods\" {\n        role = \"pod\"\n      }\n\n      discovery.relabel \"pods\" {\n        targets = discovery.kubernetes.pods.targets\n\n        rule {\n          source_labels = [\"__meta_kubernetes_namespace\"]\n          target_label  = \"namespace\"\n        }\n        rule {\n          source_labels = [\"__meta_kubernetes_pod_name\"]\n          target_label  = \"pod\"\n        }\n        rule {\n          source_labels = [\"__meta_kubernetes_pod_container_name\"]\n          target_label  = \"container\"\n        }\n      }\n\n      loki.source.kubernetes \"pods\" {\n        targets    = discovery.relabel.pods.output\n        forward_to = [loki.write.default.receiver]\n      }\n\n      loki.write \"default\" {\n        endpoint {\n          url = \"http://loki.monitoring.svc.cluster.local:3100/loki/api/v1/push\"\n        }\n      }\n\"controller\":\n  \"type\": \"daemonset\"\n"
            ],
            "verify": false,
            "version": "1.11.1",
            "wait": true,
            "wait_for_jobs": false
          },
          "sensitive_attributes": [
            [
              {
                "type": "get_attr",
                "value": "repository_password"
              }
            ]
          ],
