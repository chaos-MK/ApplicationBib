apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: applicationbib
  namespace: {{ azure.application_namespace }}
  labels:
    app: applicationbib
spec:
  selector:
    matchLabels:
      app: {{ application.backend_service }}
  endpoints:
    - port: http
      path: /actuator/prometheus
      interval: 30s
