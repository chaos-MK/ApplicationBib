apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: applicationbib
  namespace: {{ azure.application_namespace }}
  annotations:
    nginx.ingress.kubernetes.io/ssl-redirect: "true"
    nginx.ingress.kubernetes.io/use-regex: "true"
    nginx.ingress.kubernetes.io/rewrite-target: /$2
spec:
  ingressClassName: nginx

  tls:
    - hosts:
        - {{ kubernetes.ingress_host }}
      secretName: {{ kubernetes.tls_secret }}

  rules:
    - host: {{ kubernetes.ingress_host }}
      http:
        paths:
          - path: /api(/|$)(.*)
            pathType: ImplementationSpecific
            backend:
              service:
                name: {{ application.backend_service }}
                port:
                  number: 8080

          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{ application.frontend_service }}
                port:
                  number: 3000
