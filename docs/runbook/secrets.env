# ============================================================
# Ritual-Growth — Secret Rotation Configuration
# ============================================================
#
# IMPORTANT:
# - MOVE THIS FILE OUT OF THE REPOSITORY
# - Do NOT put actual secret values in this file if you will push it.
# - kubectl is used directly; no Minikube profile is required.
# ============================================================

# GitLab Registry
GITLAB_REGISTRY="registry.gitlab.com"
GITLAB_REGISTRY_USER="..."
GITLAB_REGISTRY_PASSWORD="..."

# PostgreSQL
POSTGRES_USERNAME="..."
POSTGRES_PASSWORD="..."

ALERTMANAGER_SMTP_USERNAME="..."
ALERTMANAGER_SMTP_PASSWORD="..."
ALERTMANAGER_APP_NAME="..."
ALERTMANAGER_FROM_EMAIL="..."
ALERTMANAGER_TO_EMAIL="..."


# Firebase
FIREBASE_SERVICE_ACCOUNT_JSON=''

